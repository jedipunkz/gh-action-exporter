{
  "name": "gh-action-exporter",
  "version": "0.1.0",
  "description": "Export GitHub Actions metrics to S3/GCS in Parquet format for analysis with DuckDB",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gh-action-exporter": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "github-actions",
    "metrics",
    "parquet",
    "s3",
    "gcs",
    "duckdb",
    "analytics"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "@google-cloud/storage": "^7.14.0",
    "@octokit/rest": "^21.0.2",
    "commander": "^12.1.0",
    "parquetjs": "^0.11.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
